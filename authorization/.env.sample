# Working local sample values. Replace them when targeting another API.
API_UPSTREAM=http://mock-api:8080
API_AUTH_HEADER=Authorization
# Basic authentication for test-user:test-password.
API_AUTH_VALUE='Basic dGVzdC11c2VyOnRlc3QtcGFzc3dvcmQ='

# Caller credentials for access to the proxy. The plaintext password is used
# by test.sh; only the bcrypt hash is passed into the Caddy container.
AUTH_PROXY_USER=test-proxy-user
AUTH_PROXY_PASS=test-proxy-password
AUTH_PROXY_HASH='$2a$14$D8kc7DkE2otVllA4EM0s0eQ2SvXy46nRCdkbjbCRnbDxxrQrT1nE2'

AUTH_PROXY_PORT=8091
