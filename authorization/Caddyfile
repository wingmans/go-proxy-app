{
	admin off
	auto_https off
}

:8080 {
	@health path /healthz
	log_skip @health
	handle @health {
		respond "ok" 200
	}

	handle {
		route {
			basic_auth {
				{$AUTH_PROXY_USER} {$AUTH_PROXY_HASH}
			}

			# Authenticate the caller before removing its credentials.
			request_header -Authorization
			request_header -Proxy-Authorization
			request_header -Cookie

			reverse_proxy {$API_UPSTREAM} {
				# Send only the configured upstream credential.
				header_up {$API_AUTH_HEADER} "{$API_AUTH_VALUE}"

				# Public HTTPS APIs usually require their own hostname in Host/SNI.
				header_up Host {upstream_hostport}
			}
		}
	}

	log {
		output stdout
		format json
	}
}
